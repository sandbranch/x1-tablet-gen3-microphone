+/* On the ThinkPad X1 Tablet Gen 3 the internal digital microphone on pin 0x12
+ * is not clocked unless COEF 0x07 bit 10 is set.  Without it the capture path
+ * only ever delivers broadband noise, and the DMIC's own ADC (0x07) delivers
+ * digital silence.  Vendor firmware sets this bit while a capture stream is
+ * open, which is why it is absent from the codec state left behind by it.
+ */
+static void alc295_fixup_x1_tablet_dmic(struct hda_codec *codec,
+					const struct hda_fixup *fix, int action)
+{
+	if (action == HDA_FIXUP_ACT_INIT)
+		alc_update_coef_idx(codec, 0x07, 0, 0x400);
+}
